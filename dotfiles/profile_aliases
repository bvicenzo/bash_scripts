#!/bin/bash

alias gemset='rvm gemset'

# Project search with ripgrep, skipping fixtures, cassettes, logs and dependencies.
# (It used to be called pgrep, which shadowed the system's process grep.)
alias sgrep="rg -i -g '!features/cassettes/' -g '!spec/cassettes/' -g '!spec/reports/' -g '!coverage/' -g '!spec/fixtures/' -g '!log/' -g '!tmp/' -g '!vendor/' -g '!app/assets/images/' -g '!app/frontend/images/' -g '!node_modules/' -g '!src/test/scala/fixtures/'"
alias rbf="rg -g '*.{rb,erb,arb}'"
alias jsof="rg -g '*.js'"
alias jsf="rg -g '*.{js,json,jbuilder}'"

alias fo='fuzzy_open'

# Hard clear terminal screen

alias hc="clear && printf '\e[3J'"

# Source: https://makandracards.com/makandra/25477-rbenv-how-to-update-list-of-available-ruby-versions-on-linux
alias update_rbenv_rubies_list="git -C ~/.rbenv/plugins/ruby-build pull"
