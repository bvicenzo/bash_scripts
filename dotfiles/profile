#!/usr/bin/env bash

# Resolve the dotfiles directory from this file's own location, so the repository
# can live anywhere (e.g. ~/.config/bash_scripts). BASH_SCRIPTS_PATH overrides it.
if [ -n "$BASH_SCRIPTS_PATH" ]; then
  ROOT_PATH="$BASH_SCRIPTS_PATH/dotfiles"
elif [ -n "$BASH_VERSION" ]; then
  ROOT_PATH="$(builtin cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
elif [ -n "$ZSH_VERSION" ]; then
  ROOT_PATH="$(builtin cd -- "$(dirname -- "${(%):-%x}")" && pwd)"
fi

if [ -n "$BASH_VERSION" ]; then
  if command -v brew > /dev/null && [ -f "$(brew --prefix)/etc/bash_completion" ]; then
    . "$(brew --prefix)/etc/bash_completion"
  fi

  if [[ -s "$HOME/.rvm/scripts/rvm" ]] ; then
    # Add RVM to PATH for scripting. Make sure this is the last PATH variable change.
    export PATH="$PATH:$HOME/.rvm/bin"

    source "$HOME/.rvm/scripts/rvm" # Load RVM into a shell session *as a function*
  fi

  if [ -e "$ROOT_PATH/bash_environment" ]; then
    . "$ROOT_PATH/bash_environment"
  fi
elif [ -n "$ZSH_VERSION" ]; then
  if [ -e "$ROOT_PATH/zsh_environment" ]; then
    . "$ROOT_PATH/zsh_environment"
  fi
else
   # assume something else
   echo "Unknown Shell: $SHELL"
fi

# Symbolic links are no longer created here, on every new shell: run install.sh once instead.
for profile_file_name in "profile_environment" "profile_functions" "profile_aliases" "company_profile_environment" "company_profile_functions" "company_profile_aliases" ; do
  if [ -f "$ROOT_PATH/$profile_file_name" ]; then
    . "$ROOT_PATH/$profile_file_name"
  fi
done

for profile_file_name in "company_profile_environment" "company_profile_functions" "company_profile_aliases" ; do
  if [ -f "$HOME/.$profile_file_name" ]; then
    . "$HOME/.$profile_file_name"
  fi
done
