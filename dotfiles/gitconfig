# Shared git settings. install.sh includes this file from the machine's global
# config, where user.name and user.email live (each machine has its own identity).
# The global ignore file is ~/.config/git/ignore, git's default location.
[color]
	ui = auto
[alias]
	br = branch
	cm = commit
	co = checkout
	st = status
	pl = pull
	ps = push
	plr = pull --rebase
	df = diff
	dfc = diff --cached
	dfw = diff --word-diff=plain
	clsorig = remote update origin --prune
	mg = merge
[push]
	default = simple
[pull]
	rebase = true
[init]
	defaultBranch = master
